# auto-research ローカル実行用の環境変数テンプレート
# コピーして .env を作り、値を入れる（.env は gitignore・このマシンから出さない）
#   cp scripts/auto-research/.env.example scripts/auto-research/.env

# --- Telegram（必須。配信先）---
# @BotFather で作成した bot token（このマシン外に出さない）
TELEGRAM_BOT_TOKEN=
# 自分の chat_id（ https://api.telegram.org/bot<TOKEN>/getUpdates で確認 or @userinfobot）
TELEGRAM_CHAT_ID=

# --- Claude ランタイム（/think 実行用・どちらか）---
# 推奨: サブスク（Pro/Max）を無人実行で使う長期トークン
#   `claude setup-token`（1年有効）で発行 → 下に設定。月額プラン内で課金（API課金なし）。
# CLAUDE_CODE_OAUTH_TOKEN=
# あるいは API 課金で回すなら:
# ANTHROPIC_API_KEY=

# --- 任意 ---
# interests.yaml のパス（話題taxonomyの正本。既定探索でも可）
# INTERESTS_YAML=/path/to/personal-ai-secretary/data/interests.yaml
# INDEX.md のパス（既定: workspace/INDEX.md）
# INDEX_MD=workspace/INDEX.md
# 送信せず内容だけ見る（1=dry-run）
# DRY_RUN=0
