{
  "mcpServers": {
    "gemini-deepsearch": {
      "type": "stdio",
      "command": "<PATH_TO>/gemini-deepsearch-mcp",
      "args": [],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY}"
      }
    },
    "perplexity-web": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "perplexity-web-api-mcp"]
    },
    "chatgpt": {
      "type": "stdio",
      "command": "bash",
      "args": ["-c", "cd <PATH_TO>/chatgpt-automation-mcp && uv run chatgpt-mcp"]
    },
    "social-superpowers": {
      "type": "http",
      "url": "https://superpowers.social/mcp"
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.com/mcp"
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "grok": {
      "type": "stdio",
      "command": "uvx",
      "args": ["grok-mcp"],
      "env": {
        "XAI_API_KEY": "${XAI_API_KEY}"
      }
    },
    "github": {
      "type": "stdio",
      "command": "/bin/sh",
      "args": [
        "-c",
        "GITHUB_PERSONAL_ACCESS_TOKEN=$(gh auth token) npx -y @modelcontextprotocol/server-github"
      ],
      "env": {}
    },
    "codex": {
      "type": "stdio",
      "command": "codex",
      "args": ["mcp-server"],
      "env": {}
    }
  }
}
